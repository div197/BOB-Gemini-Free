[Unit]
Description=BOB Gemini Free - Local Universal 3-in-1 AI Gateway (OpenAI, Anthropic & Gemini)
Documentation=https://github.com/div197/BOB-Gemini-Free
After=network.target

[Service]
Type=simple
User=%i
ExecStart=/usr/local/bin/bob-gemini-free --port 9610
Restart=on-failure
RestartSec=5s
Environment=BOB_GEMINI_FREE_HOST=127.0.0.1
Environment=BOB_GEMINI_FREE_PORT=9610

[Install]
WantedBy=multi-user.target
