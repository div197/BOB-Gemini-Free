{
  "build": {
    "beforeDevCommand": "./build.sh",
    "beforeBuildCommand": "./build.sh",
    "devPath": "../../web",
    "distDir": "../../web",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "BOB Gemini Free",
    "version": "0.1.7"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "sidecar": true,
        "execute": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.abcsteps.bobgeminifree",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "binaries/bob-gemini-free"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "BOB Gemini Free",
        "width": 1200,
        "height": 900
      }
    ]
  }
}
